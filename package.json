{
  "name": "smocket-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm drawing-game:snapshot:validate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "demo:server": "tsx scripts/demo-socket-server.ts",
    "seed:draw": "node scripts/draw-seed.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "drawing-game:snapshot:sync": "node scripts/sync-drawing-game-publication.mjs --write",
    "drawing-game:snapshot:validate": "node scripts/validate-drawing-game-publication.mjs",
    "drawing-game:snapshot:stale": "node scripts/sync-drawing-game-publication.mjs --check"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "smocket": "0.5.1",
    "smocket-client": "0.5.1",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "tsx": "4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
